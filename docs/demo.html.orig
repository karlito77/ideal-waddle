<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Riskintel Community Demo</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
:root{
  color-scheme:light;
  --page:#f3f5f8; --card:#ffffff; --card-2:#f7f9fb; --ink:#111519; --ink-2:#4b545e; --muted:#7a838d;
  --grid:#e4e8ed; --axis:#c5ccd4; --line:rgba(17,21,25,.10); --accent:#1c5cab; --accent-wash:rgba(28,92,171,.08);
  --s1:#2a78d6; --s2:#eb6834; --s3:#1baf7a; --seq-lo:#cde2fb;
  --good:#0ca30c; --warn:#fab219; --serious:#ec835a; --critical:#d03b3b; --good-text:#006300;
  --mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  --sans:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --page:#0e1114; --card:#171b20; --card-2:#1d2228; --ink:#f2f4f6; --ink-2:#b4bcc6; --muted:#838c96;
    --grid:#2a3037; --axis:#3a424b; --line:rgba(255,255,255,.10); --accent:#5598e7; --accent-wash:rgba(85,152,231,.12);
    --s1:#3987e5; --s2:#d95926; --s3:#199e70; --seq-lo:#184f95; --good-text:#0ca30c;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --page:#0e1114; --card:#171b20; --card-2:#1d2228; --ink:#f2f4f6; --ink-2:#b4bcc6; --muted:#838c96;
  --grid:#2a3037; --axis:#3a424b; --line:rgba(255,255,255,.10); --accent:#5598e7; --accent-wash:rgba(85,152,231,.12);
  --s1:#3987e5; --s2:#d95926; --s3:#199e70; --seq-lo:#184f95; --good-text:#0ca30c;
}
*{box-sizing:border-box}
body{margin:0;background:var(--page);color:var(--ink);font:14px/1.5 var(--sans);-webkit-font-smoothing:antialiased}
.wrap{max-width:1180px;margin:0 auto;padding-block:0 48px;padding-inline:16px}
h1,h2,h3{margin:0;text-wrap:balance;font-weight:600}
h1{font-size:20px} h2{font-size:17px} h3{font-size:14px}
p{margin:0}
.eyebrow{font:500 11px/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.mono{font-family:var(--mono);font-size:12px}
.num{font-variant-numeric:tabular-nums}

/* top bar */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--page);border-bottom:1px solid var(--line);padding-block:12px;margin-bottom:24px}
.top-in{display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px}
.brand{display:flex;align-items:center;gap:10px}
.brand .mark{width:26px;height:26px;border-radius:7px;background:var(--accent);display:grid;place-items:center}
.brand .mark svg{width:16px;height:16px}
.brand small{display:block;color:var(--muted);font-size:12px;line-height:1.2}
.seg{display:flex;gap:2px;background:var(--card-2);border:1px solid var(--line);border-radius:8px;padding:2px;margin-left:auto}
.seg button{border:0;background:transparent;color:var(--ink-2);font:500 13px var(--sans);padding:6px 12px;border-radius:6px;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--card);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.08)}
.seg button:focus-visible,.tab:focus-visible{outline:2px solid var(--accent);outline-offset:1px}

/* stepper */
.steps{display:grid;grid-template-columns:repeat(6,1fr);gap:6px;margin-bottom:28px}
.step{display:block;text-decoration:none;color:var(--ink-2);padding:8px 0 8px;border-top:2px solid var(--axis);font-size:12px}
.step b{display:block;color:var(--ink);font-weight:600;font-size:13px}
.step:hover{border-top-color:var(--accent)}
@media (max-width:640px){.steps{grid-template-columns:repeat(3,1fr)}}

/* sections */
section{margin-bottom:36px;scroll-margin-top:72px}
.sec-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px;margin-bottom:12px}
.sec-head p{color:var(--ink-2);max-width:68ch}
.grid{display:grid;gap:14px}
.g2{grid-template-columns:1fr 1fr} .g3{grid-template-columns:repeat(3,1fr)} .g4{grid-template-columns:repeat(4,1fr)}
.g21{grid-template-columns:2fr 1fr} .g12{grid-template-columns:1fr 2fr}
@media (max-width:820px){.g2,.g3,.g4,.g21,.g12{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.g2,.g3,.g4,.g21,.g12{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 16px;min-width:0}
.card h3{margin-bottom:2px}
.card .sub{color:var(--muted);font-size:12px;margin-bottom:10px}
.tile .eyebrow{margin-bottom:6px}
.tile .v{font-size:26px;font-weight:600;line-height:1.1}
.tile .d{color:var(--ink-2);font-size:12px;margin-top:4px}
.hero{background:var(--accent-wash);border-color:transparent}
.hero .v{font-size:48px;color:var(--accent)}

/* chips */
.chip{display:inline-flex;align-items:center;gap:5px;padding:1px 8px;border-radius:999px;font-size:11.5px;font-weight:500;border:1px solid var(--line);background:var(--card-2);color:var(--ink-2);white-space:nowrap}
.chip i{width:7px;height:7px;border-radius:50%;background:var(--muted);flex:none}
.chip.low i{background:var(--good)} .chip.medium i{background:var(--warn)} .chip.high i{background:var(--serious)} .chip.critical i{background:var(--critical)}
.chip.ok{color:var(--good-text)} .chip.ok i{background:var(--good)}
.chip.no{color:var(--critical)} .chip.no i{background:var(--critical)}
.chip.src{font-family:var(--mono);font-weight:400}

/* lists & tables */
.list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.list li{display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-top:1px solid var(--grid)}
.list li:first-child{border-top:0;padding-top:0}
.list .t{flex:1;min-width:0}
.list .t small{display:block;color:var(--muted);font-size:12px}
.tbl-wrap{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:13px}
th{text-align:left;font-weight:500;color:var(--muted);font-size:11.5px;letter-spacing:.04em;text-transform:uppercase;padding:6px 10px 6px 0;border-bottom:1px solid var(--axis);white-space:nowrap}
td{padding:8px 10px 8px 0;border-bottom:1px solid var(--grid);vertical-align:top}
td.r,th.r{text-align:right;font-variant-numeric:tabular-nums}
tr.rec td{background:var(--accent-wash)}
tr.rec td:first-child{border-left:3px solid var(--accent);padding-left:8px}
tr.rej td{color:var(--ink-2)}
.legend{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12px;color:var(--ink-2);margin-top:8px}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend i{width:10px;height:10px;border-radius:2px;display:inline-block}

/* charts */
.chart{width:100%;height:auto;display:block;overflow:visible}
.chart text{font-family:var(--sans);font-size:11px;fill:var(--muted)}
.chart .lab{fill:var(--ink-2);font-size:11px}
.chart .grid line{stroke:var(--grid);stroke-width:1}
.chart .axis{stroke:var(--axis);stroke-width:1}
.chart .bar{rx:0}
.chart .hit{fill:transparent}
.chart .ref{stroke:var(--ink-2);stroke-width:1;stroke-dasharray:3 3}
.chart .thr{stroke:var(--serious);stroke-width:1}
.chart .thr2{stroke:var(--critical);stroke-width:1}
.tip{position:fixed;pointer-events:none;background:var(--ink);color:var(--page);font-size:12px;padding:6px 9px;border-radius:6px;z-index:20;opacity:0;transition:opacity .08s;max-width:260px}
.tip b{display:block;font-weight:600}
.meter{height:8px;border-radius:4px;background:var(--seq-lo);overflow:hidden;margin-top:8px}
.meter i{display:block;height:100%;background:var(--accent)}
.consent{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;font-size:13px}
.consent dt{color:var(--muted)}
.consent dd{margin:0}
.reasons{margin:0;padding-left:18px;color:var(--ink-2)}
.reasons li{margin-bottom:4px}
.foot{color:var(--muted);font-size:12px;border-top:1px solid var(--line);padding-top:14px;max-width:80ch}
@media (prefers-reduced-motion:reduce){.tip{transition:none}}
</style>
</head>
<body>

<div class="top"><div class="wrap top-in">
  <div class="brand">
    <div class="mark"><svg viewBox="0 0 16 16" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round"><path d="M2 12 L6 7 L9 10 L14 3"/><path d="M2 14h12"/></svg></div>
    <div><h1>Risk Intelligence Platform</h1><small>Community demo · Logistics &amp; Warehousing</small></div>
  </div>
  <div class="seg" role="group" aria-label="Viewing as client" id="client-seg"></div>
</div></div>

<div class="wrap">
  <nav class="steps" aria-label="Pipeline">
    <a class="step" href="#ingest"><b>Ingest</b>losses, issues, IoT</a>
    <a class="step" href="#exchange"><b>Exchange</b>consent &amp; peers</a>
    <a class="step" href="#benchmark"><b>Benchmark</b>own vs pool</a>
    <a class="step" href="#model"><b>Model</b>frequency × severity</a>
    <a class="step" href="#simulate"><b>Simulate</b>aggregate loss</a>
    <a class="step" href="#decide"><b>Decide</b>retention</a>
  </nav>

  <section id="profile">
    <div class="sec-head"><h2 id="client-name"></h2><p id="client-meta" class="mono"></p></div>
    <div class="grid g4" id="tiles"></div>
  </section>

  <section id="ingest">
    <div class="sec-head"><h2>1 · Ingest</h2><p>Loss runs, the risk register and device telemetry land in one shape. Amounts are trended to 2025 money at 4% a year.</p></div>
    <div class="grid g2">
      <div class="card"><h3>Trended incurred by year</h3><div class="sub">All lines, 2025 money</div><div id="c-year"></div></div>
      <div class="card"><h3>Incurred by cause of loss</h3><div class="sub">Mapped from free text to the platform taxonomy</div><div id="c-cause"></div></div>
      <div class="card"><h3>Risk register</h3><div class="sub">Own, assessor and IoT-raised issues, ranked by severity × likelihood</div><ul class="list" id="issues"></ul></div>
      <div class="card"><h3>IoT telemetry</h3><div class="sub" id="iot-sub"></div><div id="c-iot"></div><ul class="list" id="alerts"></ul></div>
    </div>
  </section>

  <section id="exchange">
    <div class="sec-head"><h2>2 · Exchange</h2><p>Sharing is opt-in and the data owner decides. Each peer's consent is checked before any record leaves their boundary, then their chosen anonymisation is applied.</p></div>
    <div class="grid g3" id="consents"></div>
    <div class="grid g21" style="margin-top:14px">
      <div class="card"><h3 id="peers-title"></h3><div class="sub">Cohort score = 45% activity-code match + 35% same region + 20% size similarity. Peers below 0.40 are excluded.</div><div class="tbl-wrap"><table id="peers"></table></div></div>
      <div class="card"><h3>Peer issues shared in</h3><div class="sub">Learn from what neighbours found; adopt into the own register</div><ul class="list" id="shared-issues"></ul></div>
    </div>
  </section>

  <section id="benchmark">
    <div class="sec-head"><h2>3 · Benchmark</h2><p>Own experience against the pooled cohort, blended with limited-fluctuation credibility Z = n / (n + 25).</p></div>
    <div class="grid g3" id="bench"></div>
  </section>

  <section id="model">
    <div class="sec-head"><h2>4 · Model</h2><p>Poisson frequency, lognormal severity. Open risk issues load frequency by category; live IoT monitoring earns a credit.</p></div>
    <div class="grid g3" id="model-cards"></div>
  </section>

  <section id="simulate">
    <div class="sec-head"><h2>5 · Simulate</h2><p>20,000 Monte Carlo years of ground-up losses, seed 42, so every figure below is reproducible.</p></div>
    <div class="grid g21">
      <div class="card"><h3>Aggregate annual loss distribution</h3><div class="sub">Share of simulated years by total loss; top 0.5% trimmed from the axis</div><div id="c-hist"></div></div>
      <div class="card"><h3>Percentiles</h3><div class="sub">Total loss in a year at each return period</div><div class="tbl-wrap"><table id="pct"></table></div></div>
    </div>
  </section>

  <section id="decide">
    <div class="sec-head"><h2>6 · Decide</h2><p>Every candidate self-insured retention is costed on the same simulated years. The recommendation is the cheapest option that stays inside the client's risk appetite.</p></div>
    <div class="grid g12">
      <div class="grid" style="grid-template-columns:1fr;align-content:start">
        <div class="card tile hero"><div class="eyebrow">Recommended per-occurrence SIR</div><div class="v num" id="rec-sir"></div><div class="d" id="rec-sub"></div></div>
        <div class="card"><h3>Why</h3><ul class="reasons" id="reasons"></ul></div>
      </div>
      <div class="card"><h3>Total cost of risk by retention</h3><div class="sub">Expected retained + premium indication (1.35 × expected ceded) + volatility charge (½ × P95 − mean of retained)</div><div id="c-tcor"></div><div class="legend"><span><i style="background:var(--s1)"></i>Expected retained</span><span><i style="background:var(--s2)"></i>Premium indication</span><span><i style="background:var(--s3)"></i>Volatility charge</span></div></div>
    </div>
    <div class="card" style="margin-top:14px"><h3>Options table</h3><div class="sub" id="opt-sub"></div><div class="tbl-wrap"><table id="options"></table></div></div>
  </section>

  <p class="foot">Demo data: three synthetic clients seeded by <span class="mono">riskintel.demo</span>. Every number on this page was produced by running the platform's own pipeline (ingestion → exchange → benchmark → fit → 20,000-trial simulation → SIR decision); nothing is hand-typed. Pseudonyms are SHA-256 tokens of the client id, which is what a peer sees when a client shares at record level.</p>
</div>
<div class="tip" id="tip" role="status" aria-live="polite"></div>

<script>
const DATA = {"northwind":{"name":"Northwind Logistics","activity_code":"4931","revenue":120000000.0,"regions":["Yorkshire"],"locations":["Leeds DC","Sheffield Hub"],"consents":[{"scope":"loss_history","audience":"cohort_activity","anon":"pseudonymised"},{"scope":"risk_issues","audience":"community","anon":"pseudonymised"}],"experience":{"claims":31,"years":[2021,2022,2023,2024,2025],"total":490494.72061471327,"freq":0.04874213836477988,"mean":15822.410342410105,"median":9645.581747296083,"p90":23514.495251146913,"max":102256.85190762408,"by_cause":{"weather":42000.74752038675,"crime":50731.79827989254,"water":108559.7547164966,"auto.collision":125137.85000856544,"fire":112312.58069377785,"liability.slip_trip":51751.98939559411},"by_year":{"2021":57311.479334025156,"2022":81489.16290747604,"2023":111434.09758671843,"2024":190917.032455692,"2025":49342.94833080168}},"peers":[{"id":"contoso","name":"Contoso Distribution","score":0.975,"location":true,"activity_depth":4,"size_ratio":0.75,"included":true},{"id":"fabrikam","name":"Fabrikam Freight","score":0.268,"location":false,"activity_depth":1,"size_ratio":1.67,"included":false}],"pool":{"claims":30,"tokens":["aggregated"],"banded":true},"benchmark":{"own_frequency":0.04874213836477988,"pool_frequency":0.06289308176100629,"own_mean_severity":15822.410342410105,"pool_mean_severity":13866.666666666666,"pool_claim_count":30,"pool_members":1,"credibility":0.554,"blended_frequency":0.05505952380952381,"blended_mean_severity":14949.310487167499,"top_pool_causes":[["water",97500.0],["liability.slip_trip",81500.0],["weather",73000.0],["fire",70000.0],["crime",58000.0]]},"shared_issues":[{"owner_token":"d7d561e6eb09","origin_issue_id":"40d902f4641542a0b894be13ed17c7c7","category":"fire.protection","title":"Sprinkler impairment during roof works","severity":"critical","likelihood":0.3}],"issues":[{"title":"Hot work permits not enforced","category":"fire.hot_work","severity":"high","likelihood":0.4,"source":"own","score":1.2000