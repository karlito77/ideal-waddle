const ORDER = ["northwind","contoso","fabrikam"];
const fmt = n => n >= 1e6 ? (n/1e6).toFixed(2).replace(/\.?0+$/,'')+"M" : n >= 10000 ? Math.round(n/1000)+"K" : Math.round(n).toLocaleString();
const money = n => "$" + Math.round(n).toLocaleString();
const pct = n => (n*100).toFixed(0)+"%";
const cap = s => s.charAt(0).toUpperCase()+s.slice(1);
const esc = s => String(s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const tip = document.getElementById("tip");
function showTip(e, html){ tip.innerHTML = html; tip.style.opacity = 1; moveTip(e); }
function moveTip(e){ const x = Math.min(e.clientX + 14, window.innerWidth - 270); tip.style.left = x + "px"; tip.style.top = (e.clientY + 14) + "px"; }
function hideTip(){ tip.style.opacity = 0; }
function hover(el, html){ el.addEventListener("mouseenter", e => showTip(e, html)); el.addEventListener("mousemove", moveTip); el.addEventListener("mouseleave", hideTip); }
const svgNS = "http://www.w3.org/2000/svg";
function el(tag, attrs, parent){ const n = document.createElementNS(svgNS, tag); for (const k in attrs) n.setAttribute(k, attrs[k]); if (parent) parent.appendChild(n); return n; }
function chart(mount, w, h){ const m = document.getElementById(mount); m.innerHTML = ""; const s = el("svg", {viewBox:`0 0 ${w} ${h}`, class:"chart", role:"img"}); m.appendChild(s); return s; }
function niceMax(v){ const p = Math.pow(10, Math.floor(Math.log10(v))); const f = v/p; const n = f <= 1 ? 1 : f <= 2 ? 2 : f <= 2.5 ? 2.5 : f <= 5 ? 5 : 10; return n*p; }
function yGrid(s, x0, x1, y0, y1, max, ticks, fmtFn){ const g = el("g", {class:"grid"}, s); for (let i=0;i<=ticks;i++){ const v = max*i/ticks, y = y1 - (y1-y0)*i/ticks; if (i>0) el("line", {x1:x0, x2:x1, y1:y, y2:y}, g); el("text", {x:x0-6, y:y+4, "text-anchor":"end"}, s).textContent = fmtFn(v); } el("line", {x1:x0, x2:x1, y1:y1, y2:y1, class:"axis"}, s); }
function barPath(x, y, w, h, r){ if (h <= r) return `M${x},${y+h} v${-h} h${w} v${h} z`; return `M${x},${y+h} v${-(h-r)} a${r},${r} 0 0 1 ${r},${-r} h${w-2*r} a${r},${r} 0 0 1 ${r},${r} v${h-r} z`; }
function hbarPath(x, y, w, h, r){ if (w <= r) return `M${x},${y} h${w} v${h} h${-w} z`; return `M${x},${y} h${w-r} a${r},${r} 0 0 1 ${r},${r} v${h-2*r} a${r},${r} 0 0 1 ${-r},${r} h${-(w-r)} z`; }

function columnChart(mount, items, opts){
  const W = 520, H = 220, L = 52, R = 12, T = 14, B = 30;
  const s = chart(mount, W, H);
  const max = niceMax(Math.max(...items.map(i => i.v)) * 1.1);
  yGrid(s, L, W-R, T, H-B, max, 4, v => fmt(v));
  const band = (W-L-R)/items.length, bw = Math.min(24, band*0.6);
  items.forEach((it, i) => {
    const x = L + band*i + (band-bw)/2, h = (H-B-T)*it.v/max, y = H-B-h;
    el("path", {d: barPath(x, y, bw, h, 4), fill: it.color || "var(--s1)"}, s);
    el("text", {x: x+bw/2, y: H-B+16, "text-anchor":"middle"}, s).textContent = it.label;
    if (opts && opts.labelMax && it.v === Math.max(...items.map(j => j.v))) el("text", {x: x+bw/2, y: y-5, "text-anchor":"middle", class:"lab"}, s).textContent = fmt(it.v);
    const hit = el("rect", {x: L+band*i, y: T, width: band, height: H-B-T, class:"hit"}, s);
    hover(hit, `<b>${esc(it.label)}</b>${it.tip || money(it.v)}`);
  });
}
function hbarChart(mount, items){
  const rowH = 26, W = 520, L = 130, R = 60, H = items.length*rowH + 8;
  const s = chart(mount, W, H);
  const max = Math.max(...items.map(i => i.v));
  items.forEach((it, i) => {
    const y = 4 + rowH*i + 5, w = (W-L-R)*it.v/max;
    el("text", {x: L-8, y: y+12, "text-anchor":"end", class:"lab"}, s).textContent = it.label;
    el("path", {d: hbarPath(L, y, Math.max(w, 2), 16, 4), fill:"var(--s1)"}, s);
    el("text", {x: L+w+6, y: y+12, class:"lab"}, s).textContent = fmt(it.v);
    hover(el("rect", {x:0, y: 4+rowH*i, width: W, height: rowH, class:"hit"}, s), `<b>${esc(it.label)}</b>${money(it.v)} · ${pct(it.v/it.total)} of total`);
  });
  el("line", {x1:L, x2:L, y1:2, y2:H-2, class:"axis"}, s);
}
function iotChart(mount, signals, thr){
  const W = 520, H = 170, L = 40, R = 12, T = 14, B = 26;
  const s = chart(mount, W, H);
  const vals = signals.map(g => g.value);
  const max = niceMax(Math.max(...vals, thr.critical) * 1.15);
  yGrid(s, L, W-R, T, H-B, max, 4, v => v);
  const x = i => L + (W-L-R)*i/(signals.length-1), y = v => H-B - (H-B-T)*v/max;
  el("line", {x1:L, x2:W-R, y1:y(thr.warn), y2:y(thr.warn), class:"thr"}, s);
  el("text", {x: L+4, y: y(thr.warn)-4}, s).textContent = "warn " + thr.warn;
  el("line", {x1:L, x2:W-R, y1:y(thr.critical), y2:y(thr.critical), class:"thr2"}, s);
  el("text", {x: L+4, y: y(thr.critical)-4}, s).textContent = "critical " + thr.critical;
  const area = signals.map((g,i) => `${i?"L":"M"}${x(i)},${y(g.value)}`).join(" ") + ` L${x(signals.length-1)},${H-B} L${L},${H-B} Z`;
  el("path", {d: area, fill:"var(--s1)", opacity:.1}, s);
  el("path", {d: signals.map((g,i) => `${i?"L":"M"}${x(i)},${y(g.value)}`).join(" "), fill:"none", stroke:"var(--s1)", "stroke-width":2, "stroke-linejoin":"round"}, s);
  signals.forEach((g,i) => {
    const sev = g.value >= thr.critical ? "critical" : g.value >= thr.warn ? "high" : null;
    const c = el("circle", {cx:x(i), cy:y(g.value), r: sev ? 5 : 4, fill: sev ? (sev==="critical" ? "var(--critical)" : "var(--serious)") : "var(--s1)", stroke:"var(--card)", "stroke-width":2}, s);
    el("text", {x:x(i), y:H-B+16, "text-anchor":"middle"}, s).textContent = g.at.slice(11,16);
    hover(el("circle", {cx:x(i), cy:y(g.value), r:12, class:"hit"}, s), `<b>${g.at.slice(0,16).replace("T"," ")}</b>${g.value} ${esc(g.metric)}${sev ? " · " + sev : ""}`);
  });
}
function histChart(mount, sim){
  const W = 620, H = 220, L = 44, R = 12, T = 14, B = 30;
  const s = chart(mount, W, H);
  const counts = sim.hist.counts, n = counts.length, total = counts.reduce((a,b)=>a+b,0);
  const maxShare = niceMax(Math.max(...counts)/total*1.1);
  yGrid(s, L, W-R, T, H-B, maxShare, 4, v => (v*100).toFixed(0)+"%");
  const bw = (W-L-R)/n;
  counts.forEach((c,i) => {
    const h = (H-B-T)*(c/total)/maxShare, x = L + bw*i;
    el("path", {d: barPath(x+1, H-B-h, bw-2, h, 3), fill:"var(--s1)"}, s);
    const lo = sim.hist.max*i/n, hi = sim.hist.max*(i+1)/n;
    hover(el("rect", {x, y:T, width:bw, height:H-B-T, class:"hit"}, s), `<b>${money(lo)} – ${money(hi)}</b>${pct(c/total)} of years (${c.toLocaleString()} of ${total.toLocaleString()})`);
  });
  for (let i=0;i<=4;i++){ const v = sim.hist.max*i/4; el("text", {x: L+(W-L-R)*i/4, y: H-B+16, "text-anchor": i===0?"start":i===4?"end":"middle"}, s).textContent = fmt(v); }
  [["mean", sim.mean],["P90", sim.p90],["P99", sim.p99]].forEach(([k,v],j) => {
    const x = L + (W-L-R)*Math.min(v/sim.hist.max, 1);
    el("line", {x1:x, x2:x, y1:T+14, y2:H-B, class:"ref"}, s);
    el("text", {x:x+4, y:T+10, class:"lab"}, s).textContent = `${k} ${fmt(v)}`;
  });
}
function tcorChart(mount, opts, rec){
  const W = 620, H = 240, L = 52, R = 12, T = 14, B = 30;
  const s = chart(mount, W, H);
  const max = niceMax(Math.max(...opts.map(o => o.total_cost_of_risk))*1.12);
  yGrid(s, L, W-R, T, H-B, max, 4, v => fmt(v));
  const band = (W-L-R)/opts.length, bw = Math.min(24, band*0.5);
  opts.forEach((o,i) => {
    const x = L + band*i + (band-bw)/2;
    const parts = [[o.expected_retained,"var(--s1)","Expected retained"],[o.premium_indication,"var(--s2)","Premium indication"],[o.volatility_charge,"var(--s3)","Volatility charge"]];
    let y = H-B;
    parts.forEach(([v,c],k) => { const h = (H-B-T)*v/max; y -= h; if (h > 0) el("path", {d: k===2 ? barPath(x, y, bw, Math.max(h-2,0), 4) : `M${x},${y} h${bw} v${Math.max(h-2,0)} h${-bw} z`, fill:c}, s); });
    const lab = el("text", {x:x+bw/2, y:y-6, "text-anchor":"middle", class:"lab"}, s); lab.textContent = fmt(o.total_cost_of_risk); if (o.sir===rec) lab.setAttribute("font-weight","600");
    el("text", {x:x+bw/2, y:H-B+16, "text-anchor":"middle", "font-weight": o.sir===rec ? "600" : "400"}, s).textContent = "$" + fmt(o.sir);
    hover(el("rect", {x:L+band*i, y:T, width:band, height:H-B-T, class:"hit"}, s), `<b>SIR ${money(o.sir)}</b>` + parts.map(([v,,n]) => `${n}: ${money(v)}`).join("<br>") + `<br>TCOR: ${money(o.total_cost_of_risk)}`);
  });
}

const THR = {water_flow_lpm:{warn:20,critical:60}, temperature_c:{warn:45,critical:60}};
const CONSENT_WORDS = {loss_history:"Loss history", risk_issues:"Risk issues", iot_signals:"IoT signals", community:"whole community", cohort_location:"same-region cohort", cohort_activity:"same-activity cohort", none:"nobody", aggregated:"banded aggregates", pseudonymised:"pseudonymised records", identified:"identified records"};

function render(id){
  const d = DATA[id];
  document.querySelectorAll("#client-seg button").forEach(b => b.setAttribute("aria-pressed", b.dataset.id===id));
  document.getElementById("client-name").textContent = d.name;
  document.getElementById("client-meta").textContent = `activity ${d.activity_code} · ${d.regions.join(", ")} · ${d.locations.length} location${d.locations.length>1?"s":""} · revenue ${money(d.revenue)}`;
  const ex = d.experience, m = d.model, sim = d.sim, dec = d.decision;
  document.getElementById("tiles").innerHTML = [
    ["Claims on record", ex.claims, `${ex.years[0]}–${ex.years[ex.years.length-1]}, all lines`],
    ["Trended incurred", money(ex.total), `mean ${money(ex.mean)}, P90 ${money(ex.p90)}`],
    ["Frequency", ex.freq.toFixed(3), "claims per $1M revenue per year"],
    ["Modelled expected annual loss", money(m.eal), `${m.freq.toFixed(1)} claims × modifier ${m.modifier.toFixed(2)} × ${money(m.exp_sev)}`],
  ].map(([l,v,s]) => `<div class="card tile"><div class="eyebrow">${l}</div><div class="v">${v}</div><div class="d">${s}</div></div>`).join("");

  const years = Object.keys(ex.by_year).sort();
  columnChart("c-year", years.map(y => ({label:y, v:ex.by_year[y]})), {labelMax:true});
  const causes = Object.entries(ex.by_cause).sort((a,b)=>b[1]-a[1]);
  hbarChart("c-cause", causes.map(([k,v]) => ({label:k, v, total:ex.total})));

  document.getElementById("issues").innerHTML = d.issues.sort((a,b)=>b.score-a.score).map(i => `<li><span class="chip ${i.severity}"><i></i>${cap(i.severity)}</span><div class="t">${esc(i.title)}<small><span class="mono">${esc(i.category)}</span> · likelihood ${pct(i.likelihood)} · score ${i.score.toFixed(1)}</small></div><span class="chip src">${i.source}</span></li>`).join("") || `<li><div class="t">No open issues.</div></li>`;

  const metric = d.signals.length ? d.signals[0].metric : null;
  document.getElementById("iot-sub").textContent = metric ? `${metric.replace(/_/g," ")} on ${d.locations[0]}, 1 Dec 2025 · thresholds from the default table` : "No devices connected";
  if (metric) iotChart("c-iot", d.signals, THR[metric]); else document.getElementById("c-iot").innerHTML = "";
  document.getElementById("alerts").innerHTML = d.alerts.length
    ? d.alerts.map(a => `<li><span class="chip ${a.severity}"><i></i>${cap(a.severity)}</span><div class="t">${esc(a.device)} read ${a.value} ${esc(a.metric.replace(/_/g," "))}<small>${a.at.slice(0,16).replace("T"," ")}</small></div></li>`).join("") + (d.alerts.length>=2 ? `<li><div class="t"><small>Repeated alerts on one device were promoted to an IoT-sourced risk issue, and the live monitoring earns a frequency credit in the model.</small></div></li>` : "")
    : `<li><div class="t"><small>All readings inside thresholds; no alerts raised.</small></div></li>`;

  document.getElementById("consents").innerHTML = ORDER.map(cid => { const c = DATA[cid]; const rows = c.consents.length ? c.consents.map(k => `<dt>${CONSENT_WORDS[k.scope]}</dt><dd>${CONSENT_WORDS[k.audience]} · ${CONSENT_WORDS[k.anon]}</dd>`).join("") : `<dt>Everything</dt><dd>shared with nobody</dd>`; return `<div class="card"><h3>${esc(c.name)}${cid===id ? ' <span class="chip">viewing as</span>' : ""}</h3><div class="sub">activity ${c.activity_code} · ${c.regions.join(", ")}</div><dl class="consent">${rows}</dl></div>`; }).join("");

  document.getElementById("peers-title").textContent = `What ${d.name} can see`;
  document.getElementById("peers").innerHTML = `<thead><tr><th>Peer</th><th class="r">Score</th><th>Region</th><th>Activity</th><th>In cohort</th><th>Losses received</th></tr></thead><tbody>` + d.peers.map(p => {
    const pc = DATA[p.id].consents.find(k => k.scope==="loss_history");
    const audienceOk = pc && (pc.audience==="community" || (pc.audience==="cohort_location" && p.location) || (pc.audience==="cohort_activity" && p.activity_depth>=2));
    const receives = !p.included ? "nothing (outside cohort)" : !pc ? "nothing (no consent)" : audienceOk ? CONSENT_WORDS[pc.anon] : `nothing (${CONSENT_WORDS[pc.audience]} only)`;
    return `<tr><td>${esc(p.name)}</td><td class="r">${p.score.toFixed(2)}</td><td>${p.location ? "same" : "different"}</td><td>${p.activity_depth} of 4 digits</td><td><span class="chip ${p.included?"ok":"no"}"><i></i>${p.included?"yes":"no"}</span></td><td>${receives}</td></tr>`; }).join("") + `</tbody>`;

  document.getElementById("shared-issues").innerHTML = d.shared_issues.length ? d.shared_issues.map(i => `<li><span class="chip ${i.severity}"><i></i>${cap(i.severity)}</span><div class="t">${esc(i.title)}<small>from <span class="mono">${i.owner_token}</span> · <span class="mono">${esc(i.category)}</span></small></div></li>`).join("") : `<li><div class="t"><small>No peer has consented to share issues with ${esc(d.name)}.</small></div></li>`;

  const b = d.benchmark;
  document.getElementById("bench").innerHTML = b ? [
    ["Frequency per $1M", b.own_frequency.toFixed(3), b.pool_frequency.toFixed(3), b.blended_frequency.toFixed(3)],
    ["Mean severity", money(b.own_mean_severity), money(b.pool_mean_severity), money(b.blended_mean_severity)],
  ].map(([l,o,p,bl]) => `<div class="card"><h3>${l}</h3><div class="sub">own · pool · blended</div><table><tr><td>Own</td><td class="r">${o}</td></tr><tr><td>Pool (${b.pool_claim_count} claims, ${b.pool_members} member${b.pool_members>1?"s":""})</td><td class="r">${p}</td></tr><tr><td><b>Blended</b></td><td class="r"><b>${bl}</b></td></tr></table></div>`).join("")
    + `<div class="card"><h3>Credibility on own data</h3><div class="sub">Z = ${ex.claims} / (${ex.claims} + 25)</div><div class="tile"><div class="v">${(b.credibility*100).toFixed(0)}%</div></div><div class="meter"><i style="width:${b.credibility*100}%"></i></div><div class="d" style="color:var(--ink-2);font-size:12px;margin-top:8px">Top pool causes: ${b.top_pool_causes.slice(0,3).map(c => esc(c[0])).join(", ")}</div></div>`
    : `<div class="card"><h3>No pooled data</h3><p style="color:var(--ink-2)">No peer has consented to share losses that ${esc(d.name)} qualifies for, so the model runs on own experience only.</p></div>`;

  document.getElementById("model-cards").innerHTML = `
    <div class="card"><h3>Frequency</h3><div class="sub">${esc(m.basis)}</div><table><tr><td>Base annual claims</td><td class="r">${m.freq.toFixed(2)}</td></tr><tr><td>Modifier</td><td class="r">× ${m.modifier.toFixed(3)}</td></tr><tr><td><b>Modelled λ</b></td><td class="r"><b>${(m.freq*m.modifier).toFixed(2)}</b></td></tr></table></div>
    <div class="card"><h3>Severity</h3><div class="sub">Lognormal, fitted on trended amounts</div><table><tr><td>μ</td><td class="r">${m.mu.toFixed(3)}</td></tr><tr><td>σ</td><td class="r">${m.sigma.toFixed(3)}</td></tr><tr><td><b>Expected severity</b></td><td class="r"><b>${money(m.exp_sev)}</b></td></tr></table></div>
    <div class="card"><h3>Modifiers applied</h3><div class="sub">From the risk register and device coverage</div><ul class="list">${m.notes.length ? m.notes.map(n => `<li><span class="chip ${n.startsWith("+")?"high":"ok"}"><i></i>${n.split(" ")[0]}</span><div class="t">${esc(n.slice(n.indexOf(" ")+1))}</div></li>`).join("") : `<li><div class="t">None: no open issues in a modelled category and no monitoring.</div></li>`}</ul></div>`;

  histChart("c-hist", sim);
  document.getElementById("pct").innerHTML = `<thead><tr><th>Return period</th><th class="r">Annual loss</th></tr></thead><tbody>` + [["Mean", sim.mean],["1 in 2 (P50)", sim.p50],["1 in 4 (P75)", sim.p75],["1 in 10 (P90)", sim.p90],["1 in 20 (P95)", sim.p95],["1 in 100 (P99)", sim.p99],["Worst simulated", sim.max]].map(([k,v]) => `<tr><td>${k}</td><td class="r">${money(v)}</td></tr>`).join("") + `</tbody>`;

  document.getElementById("rec-sir").textContent = dec.recommended != null ? money(dec.recommended) : "None";
  document.getElementById("rec-sub").textContent = `Appetite: 1-in-100 retained loss no more than ${money(d.appetite)}`;
  document.getElementById("reasons").innerHTML = dec.reasons.map(r => `<li>${esc(r)}</li>`).join("");
  tcorChart("c-tcor", dec.options, dec.recommended);
  document.getElementById("opt-sub").textContent = `${Object.keys(dec.rejected).length} of ${dec.options.length} candidates breach the appetite`;
  document.getElementById("options").innerHTML = `<thead><tr><th>SIR</th><th class="r">E[retained]</th><th class="r">P95 retained</th><th class="r">P99 retained</th><th class="r">E[ceded]</th><th class="r">Premium</th><th class="r">TCOR</th><th>Status</th></tr></thead><tbody>` + dec.options.map(o => {
    const rej = dec.rejected[String(o.sir)] || dec.rejected[String(o.sir.toFixed(1))];
    const cls = o.sir===dec.recommended ? "rec" : rej ? "rej" : "";
    const status = o.sir===dec.recommended ? `<span class="chip ok"><i></i>recommended</span>` : rej ? `<span class="chip no"><i></i>breaches appetite</span>` : `<span class="chip"><i></i>feasible</span>`;
    return `<tr class="${cls}"><td class="num">${money(o.sir)}</td><td class="r">${money(o.expected_retained)}</td><td class="r">${money(o.retained_p95)}</td><td class="r">${money(o.retained_p99)}</td><td class="r">${money(o.expected_ceded)}</td><td class="r">${money(o.premium_indication)}</td><td class="r"><b>${money(o.total_cost_of_risk)}</b></td><td>${status}</td></tr>`; }).join("") + `</tbody>`;
}

const seg = document.getElementById("client-seg");
ORDER.forEach(id => { const b = document.createElement("button"); b.type = "button"; b.dataset.id = id; b.id = "seg-" + id; b.textContent = DATA[id].name.split(" ")[0]; b.addEventListener("click", () => { render(id); try { localStorage.setItem("riskintel-client", id); } catch (e) {} }); seg.appendChild(b); });
let start = "northwind"; try { const s = localStorage.getItem("riskintel-client"); if (s && DATA[s]) start = s; } catch (e) {}
render(start);
</script>

</body>
</html>
